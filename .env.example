# Copy to .env and fill in. Never commit .env.

# --- Claude (trade reviewer) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = slower, more thorough review)
CLAUDE_EFFORT=medium
# Skip any trade Claude rates below this confidence (0-1)
LLM_MIN_CONFIDENCE=0.6
# Set to false to trade the raw rules without Claude
USE_LLM=true

# --- Market ---
EXCHANGE=coinbase
SYMBOLS=BTC/USD,ETH/USD
# 15m+ recommended: on 1m/5m bars typical moves are smaller than retail fees
TIMEFRAME=15m
POLL_SECONDS=15

# --- Costs (basis points; 100 bps = 1%). Set to YOUR exchange fee tier. ---
FEE_BPS=25
SLIPPAGE_BPS=5

# --- Risk limits (percent of equity) ---
STARTING_CASH=1000
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=25
MAX_DAILY_LOSS_PCT=2
MAX_TRADES_PER_DAY=8
MAX_OPEN_POSITIONS=2

# --- Live trading only (real money). Leave blank until paper results are good. ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges need a passphrase
EXCHANGE_API_PASSWORD=
# Hard cap on the dollars the bot may use, regardless of account balance
LIVE_MAX_CAPITAL=200
